{
  "manifest_version": 3,
  "name": "CallCenter - TOOLS",
  "version": "1.19",
  "description": "Ferramenta para facilitar o trabalho do Call.",
  "homepage_url": "https://github.com/lv777x/call-center-tools",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage",
    "offscreen"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://chat.oquei.com.br/*",
    "https://web.whatsapp.com/*",
    "https://elleven.oquei.com.br/*",
    "https://oquei.sz.chat/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/logo.png"],
      "matches": [
        "https://web.whatsapp.com/*",
        "https://chat.oquei.com.br/*",
        "https://elleven.oquei.com.br/*",
        "https://oquei.sz.chat/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://chat.oquei.com.br/*",
        "https://elleven.oquei.com.br/*",
        "https://oquei.sz.chat/*"
      ],
      "js": [
        "ferramentas-comuns.js",
        "snippets-content.js",
        "botao-flutuante.js",
        "barra-lateral.js"
      ],
      "css": [
        "botao-flutuante.css",
        "barra-lateral.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CallCenter - TOOLS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/toolbar16.png",
      "32": "icons/toolbar32.png",
      "48": "icons/toolbar48.png"
    }
  },
  "commands": {
    "send-prox": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Enviar 'prox' no grupo rodizio_ligacoes_callcenter_tarde"
    },
    "send-check": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Enviar ✅ no grupo rodizio_ligacoes_callcenter_tarde"
    },
    "abrir-barra-lateral": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "Abrir/fechar a barra lateral do CallCenter Tools"
    }
  }
}
